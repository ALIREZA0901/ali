<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="UmbraBackground">#12141A</Color>
  <Color x:Key="UmbraSurface">#1B1F2A</Color>
  <Color x:Key="UmbraAccent">#6C8CFF</Color>
  <Color x:Key="UmbraText">#E7E9F0</Color>
  <Color x:Key="UmbraMuted">#9AA3B2</Color>
  <Color x:Key="UmbraBorder">#2B3140</Color>

  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource UmbraBackground}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource UmbraSurface}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource UmbraAccent}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource UmbraText}" />
  <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource UmbraMuted}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource UmbraBorder}" />
</ResourceDictionary>
