<Window x:Class="Umbra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Umbra" Width="1200" Height="740" MinWidth="1000" MinHeight="680">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{StaticResource Brush.Surface}" Grid.Column="0" Padding="16">
      <StackPanel>
        <TextBlock Text="Umbra" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" />
        <Button Style="{StaticResource SidebarButton}" Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
        <Button Style="{StaticResource SidebarButton}" Content="Profiles" Command="{Binding NavigateCommand}" CommandParameter="Profiles" />
        <Button Style="{StaticResource SidebarButton}" Content="Streaming Assist" Command="{Binding NavigateCommand}" CommandParameter="Streaming" />
        <Button Style="{StaticResource SidebarButton}" Content="DNS" Command="{Binding NavigateCommand}" CommandParameter="DNS" />
        <Button Style="{StaticResource SidebarButton}" Content="VPN Manager" Command="{Binding NavigateCommand}" CommandParameter="VPN" />
        <Button Style="{StaticResource SidebarButton}" Content="Routing" Command="{Binding NavigateCommand}" CommandParameter="Routing" />
        <Button Style="{StaticResource SidebarButton}" Content="Updates" Command="{Binding NavigateCommand}" CommandParameter="Updates" />
        <Button Style="{StaticResource SidebarButton}" Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
        <Button Style="{StaticResource SidebarButton}" Content="Logs" Command="{Binding NavigateCommand}" CommandParameter="Logs" />
      </StackPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ContentControl Content="{Binding CurrentViewModel}" Margin="24" />
      <Border Grid.Row="1" Background="{StaticResource Brush.Surface}" Padding="12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,1,0,0">
        <UniformGrid Columns="5">
          <StackPanel>
            <TextBlock Text="Active Profile" Foreground="{StaticResource Brush.Muted}" />
            <TextBlock Text="{Binding Status.ActiveProfileName}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="DNS" Foreground="{StaticResource Brush.Muted}" />
            <TextBlock Text="{Binding Status.DnsStatus}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="VPN" Foreground="{StaticResource Brush.Muted}" />
            <TextBlock Text="{Binding Status.VpnStatus}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Routing" Foreground="{StaticResource Brush.Muted}" />
            <TextBlock Text="{Binding Status.RoutingStatus}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Last Diagnostics" Foreground="{StaticResource Brush.Muted}" />
            <TextBlock Text="{Binding LastDiagnosticsSummary}" />
          </StackPanel>
        </UniformGrid>
      </Border>
    </Grid>
  </Grid>
</Window>
