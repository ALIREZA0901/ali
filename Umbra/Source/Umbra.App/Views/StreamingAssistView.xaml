<UserControl x:Class="Umbra.Views.StreamingAssistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Streaming Assist" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="Diagnostics run only from Settings." Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,16" />

    <TabControl>
      <TabItem Header="Aparat">
        <StackPanel Margin="12">
          <TextBlock Text="Last 60s result" FontWeight="SemiBold" />
          <TextBlock Text="{Binding LastAparatSummary}" Margin="0,6,0,0" />
          <TextBlock Text="Jitter / loss timeline shown after running diagnostics." Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,12" />
          <Button Content="Run from Settings" Width="160" Command="{Binding GoToSettingsCommand}" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Kick">
        <StackPanel Margin="12">
          <TextBlock Text="Last 60s result" FontWeight="SemiBold" />
          <TextBlock Text="{Binding LastKickSummary}" Margin="0,6,0,0" />
          <TextBlock Text="Jitter / loss timeline shown after running diagnostics." Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,12" />
          <Button Content="Run from Settings" Width="160" Command="{Binding GoToSettingsCommand}" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</UserControl>
