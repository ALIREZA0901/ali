<UserControl x:Class="Umbra.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Profiles" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Apply each section independently. No changes apply without confirmation." Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,16" />

      <ItemsControl ItemsSource="{Binding Profiles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource Brush.Surface}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="Apply DNS" Command="{Binding DataContext.ApplyDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <Button Content="Apply VPN" Command="{Binding DataContext.ApplyVpnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0" />
                  <Button Content="Apply Routing" Command="{Binding DataContext.ApplyRoutingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0" />
                  <Button Content="Apply Load Balance" Command="{Binding DataContext.ApplyLoadBalanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0" />
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="Export" Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Background="#3A3F52" />
                  <Button Content="Import" Command="{Binding DataContext.ImportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0" Background="#3A3F52" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
