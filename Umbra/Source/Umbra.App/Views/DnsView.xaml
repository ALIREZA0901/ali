<UserControl x:Class="Umbra.Views.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="DNS Manager" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="Apply and optimize DNS only from explicit actions." Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,16" />

    <WrapPanel Margin="0,0,0,12">
      <TextBox Width="240" Text="{Binding SearchText}" Margin="0,0,12,0" />
      <Button Content="Apply DNS" Command="{Binding ApplyDnsCommand}" />
      <Button Content="Revert DNS Changes" Command="{Binding RevertDnsCommand}" Background="#3A3F52" Margin="8,0,0,0" />
    </WrapPanel>

    <DataGrid ItemsSource="{Binding Catalog}" Height="320">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Primary" Binding="{Binding Primary}" Width="140" />
        <DataGridTextColumn Header="Secondary" Binding="{Binding Secondary}" Width="140" />
        <DataGridTextColumn Header="Protocols" Binding="{Binding Protocols}" Width="140" />
        <DataGridTextColumn Header="Region" Binding="{Binding RegionTag}" Width="80" />
      </DataGrid.Columns>
    </DataGrid>
  </StackPanel>
</UserControl>
