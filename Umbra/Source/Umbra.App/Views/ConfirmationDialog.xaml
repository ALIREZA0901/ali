<Window x:Class="Umbra.Views.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Height="360" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
      <Border Background="#2A3040" CornerRadius="6" Padding="10" Margin="0,10,0,0">
        <StackPanel>
          <TextBlock Text="Before" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Before}" TextWrapping="Wrap" />
          <TextBlock Text="After" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Text="{Binding After}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding RiskLabel}" Foreground="#FFC857" Margin="0,8,0,0" />
      <CheckBox Content="Don't show again for this exact action" IsChecked="{Binding SuppressFuture}" Visibility="{Binding SuppressVisibility}" />
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Deny" Width="90" Background="#3A3F52" Command="{Binding DenyCommand}" Margin="0,0,8,0" />
      <Button Content="Accept" Width="90" Command="{Binding AcceptCommand}" />
    </StackPanel>
  </Grid>
</Window>
