<UserControl x:Class="Umbra.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Status" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="Active profile, DNS, VPN, and routing summary." Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,16" />
    <UniformGrid Columns="2" Rows="2" Margin="0,0,0,20">
      <Border Background="{StaticResource Brush.Surface}" CornerRadius="8" Padding="12" Margin="0,0,12,12">
        <StackPanel>
          <TextBlock Text="Active Profile" Foreground="{StaticResource Brush.Muted}" />
          <TextBlock Text="{Binding Status.ActiveProfileName}" FontSize="16" />
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Brush.Surface}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="DNS" Foreground="{StaticResource Brush.Muted}" />
          <TextBlock Text="{Binding Status.DnsStatus}" FontSize="16" />
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Brush.Surface}" CornerRadius="8" Padding="12" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="VPN" Foreground="{StaticResource Brush.Muted}" />
          <TextBlock Text="{Binding Status.VpnStatus}" FontSize="16" />
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Brush.Surface}" CornerRadius="8" Padding="12">
        <StackPanel>
          <TextBlock Text="Routing" Foreground="{StaticResource Brush.Muted}" />
          <TextBlock Text="{Binding Status.RoutingStatus}" FontSize="16" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Border Background="{StaticResource Brush.Surface}" CornerRadius="8" Padding="12">
      <StackPanel>
        <TextBlock Text="Copilot" FontWeight="SemiBold" />
        <TextBlock Text="Level: {Binding CopilotLevel}" />
        <TextBlock Text="Latest diagnostics available in Settings." Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,0" />
        <Button Content="Go to Settings" Width="140" Command="{Binding GoToSettingsCommand}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
