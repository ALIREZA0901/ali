<UserControl x:Class="Umbra.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Updates" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="App update status" Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,16" />

    <Border Background="{StaticResource Brush.Surface}" CornerRadius="8" Padding="12">
      <StackPanel>
        <TextBlock Text="Umbra App" FontWeight="SemiBold" />
        <TextBlock Text="{Binding AppUpdateStatus}" Foreground="{StaticResource Brush.Muted}" />
      </StackPanel>
    </Border>

    <Border Background="{StaticResource Brush.Surface}" CornerRadius="8" Padding="12" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="Core Updates" FontWeight="SemiBold" />
        <WrapPanel Margin="0,8,0,0">
          <Button Content="Check Updates" Command="{Binding CheckUpdatesCommand}" />
          <Button Content="Update All" Command="{Binding UpdateAllCommand}" Margin="8,0,0,0" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
